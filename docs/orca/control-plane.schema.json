{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tempo-flow.example/schemas/orca-control-plane.schema.json",
  "title": "Orca GitHub-first control-plane manifest",
  "type": "object",
  "required": ["version", "ticket", "role", "providerAccount", "run", "gates"],
  "properties": {
    "version": { "type": "string", "const": "1" },
    "ticket": { "$ref": "#/$defs/ticket" },
    "role": { "$ref": "#/$defs/role" },
    "providerAccount": { "$ref": "#/$defs/providerAccount" },
    "run": { "$ref": "#/$defs/run" },
    "gates": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "ticket": {
      "type": "object",
      "required": ["system", "repository", "issueNumber", "titlePrefix"],
      "properties": {
        "system": { "type": "string", "const": "github-issue" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "issueNumber": { "type": "integer", "minimum": 1 },
        "titlePrefix": { "type": "string", "pattern": "^🎫 " },
        "projectView": { "type": "string", "const": "github-project-ordered-view" }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["id", "kind", "titlePrefix"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "type": "string", "enum": ["builder", "reviewer", "integrator", "release-observer"] },
        "titlePrefix": { "type": "string", "pattern": "^🧭 " },
        "humanApprovalRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "providerAccount": {
      "type": "object",
      "required": ["id", "provider", "billingClass", "overagePolicy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "provider": { "type": "string", "enum": ["codex", "claude-code", "gemini-cli", "grok", "cursor", "amp", "devin", "hermes"] },
        "billingClass": { "type": "string", "enum": ["fixed-subscription", "metered-api", "unknown"] },
        "overagePolicy": { "type": "string", "enum": ["fail-closed", "manual-approval", "unknown"] },
        "titlePrefix": { "type": "string", "pattern": "^🤖 " }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["id", "mode", "commitSha", "dispatch", "resultBinding"],
      "properties": {
        "id": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
        "mode": { "type": "string", "enum": ["dry-run", "manual-dispatch", "autonomous"] },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dispatch": { "type": "string", "enum": ["none", "manual-only", "github-actions"] },
        "resultBinding": { "type": "string", "const": "commit-sha" },
        "codeChangingRepair": { "type": "string", "enum": ["restart-ci", "manual-review"] }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["id", "sequence", "kind", "required", "resultBinding"],
      "properties": {
        "id": { "type": "string", "enum": ["integration", "ci", "security", "playwright-ux-ui", "preview"] },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "kind": { "type": "string", "enum": ["automated", "human"] },
        "required": { "type": "boolean", "const": true },
        "resultBinding": { "type": "string", "const": "commit-sha" },
        "onCodeChange": { "type": "string", "enum": ["restart-ci", "stop"] }
      },
      "additionalProperties": false
    }
  }
}

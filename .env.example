# ============================================================================
# Tempo Rhythm — Workspace Root Environment Variables
# ============================================================================
# This file is the canonical list of env vars consumed at the monorepo root
# (Convex backend, shared tooling). Per-app vars live in the app's own
# .env.example (apps/web/.env.example, apps/mobile/.env.example).
#
# Never commit real secret values. Real values live in:
#   - Convex dashboard (per-deployment env vars) for convex/ runtime
#   - Vercel project env vars for apps/web build + runtime
#   - EAS secrets for apps/mobile builds
#
# Placeholder hygiene: cells scaffolded with the literal `__DUMMY_PASTE_ME__`
# sentinel are treated as ABSENT by the code (packages/ai requireEnv), same
# as empty/whitespace — a half-configured deployment fails loudly.
#
# See docs/HARD_RULES.md §13.
# See docs/ENVIRONMENTS.md for the four-mode contract (dev / test / preview / deployment).
# ============================================================================

# ----------------------------------------------------------------------------
# Convex (required)
# ----------------------------------------------------------------------------
# CONVEX_DEPLOYMENT — written automatically into .env.local by `bun x convex dev`.
# Source: generated locally. Required for local dev. [local]
CONVEX_DEPLOYMENT=dev:your-project-name-here

# CONVEX_SITE_URL — AUTO-POPULATED BY CONVEX on every deployment; never set
# it by hand (convex/auth.config.ts and the voice callback read it from the
# deployment itself). Listed here for documentation only. [convex — automatic]
# CONVEX_SITE_URL=

# CONVEX_DEPLOY_KEY — production deploy key for CI / Vercel builds only.
# Source: Convex dashboard → Settings → Deploy Keys. Required for CI deploys,
# never needed locally. [vercel production]
CONVEX_DEPLOY_KEY=

# ----------------------------------------------------------------------------
# AI — chat (Mistral; HARD_RULES §6.1: native fetch, no vendor SDKs)
# ----------------------------------------------------------------------------
# MISTRAL_API_KEY — read by convex/lib/ai_router.ts for all chat tiers.
# Source: console.mistral.ai → API Keys. Required for AI features. [convex dashboard]
MISTRAL_API_KEY=

# Per-modality AI config (packages/ai registry). Each triplet is optional —
# defaults: chat→mistral, stt/tts→deepgram (nova-3 / aura-2). Provider-
# agnostic on purpose (e.g. AI_CHAT_PROVIDER=inkling later). [convex dashboard]
# AI_CHAT_PROVIDER=
# AI_CHAT_MODEL=
# AI_CHAT_API_KEY=
# AI_STT_PROVIDER=
# AI_STT_MODEL=
# AI_STT_API_KEY=
# AI_TTS_PROVIDER=
# AI_TTS_MODEL=
# AI_TTS_API_KEY=
# AI_EMBEDDINGS_PROVIDER=
# AI_EMBEDDINGS_MODEL=
# AI_EMBEDDINGS_API_KEY=

# DEPRECATED single-slot triplet — still honored for chat (convex/memories.ts)
# until both deployments carry the AI_CHAT_* names; prefer the new names.
# [convex dashboard]
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=

# ----------------------------------------------------------------------------
# Voice — Deepgram STT (batch callbacks + streaming token grants)
# ----------------------------------------------------------------------------
# DEEPGRAM_API_KEY — Tempo's own Deepgram key; final fallback when a user has
# no BYOK key. Source: console.deepgram.com → API Keys. Required for voice.
# [convex dashboard]
DEEPGRAM_API_KEY=

# DEEPGRAM_CALLBACK_SECRET — shared secret embedded in the async-transcription
# callback URL and verified by convex/voice.ts (fail closed). Source: generate
# locally, e.g. `openssl rand -base64 32`. Required for batch voice. [convex dashboard]
DEEPGRAM_CALLBACK_SECRET=

# ----------------------------------------------------------------------------
# BYOK — per-user provider keys, encrypted at rest
# ----------------------------------------------------------------------------
# BYOK_MASTER_KEY — 32+ random bytes, base64; per-user AES-256-GCM keys are
# HKDF-derived from it (convex/lib/byok_crypto.ts). Source: generate locally,
# e.g. `openssl rand -base64 32`. Required for BYOK key storage. Rotating it
# invalidates stored keys (users re-paste). [convex dashboard]
BYOK_MASTER_KEY=

# ----------------------------------------------------------------------------
# Auth — magic-link email (Resend)
# ----------------------------------------------------------------------------
# RESEND_API_KEY — used by convex/auth.ts to send magic-link emails. Optional:
# when unset, the link is printed to Convex logs (dev-only fallback).
# Source: resend.com → API Keys. [convex dashboard]
RESEND_API_KEY=
# RESEND_FROM_EMAIL — from-address for magic-link emails. Optional; defaults
# to "Tempo Flow <onboarding@resend.dev>". Use a verified Resend domain in
# production. [convex dashboard]
RESEND_FROM_EMAIL=

# ----------------------------------------------------------------------------
# Beta gating (convex/auth.ts; NOT read by Vercel / Next.js)
# ----------------------------------------------------------------------------
# BETA_FOUNDER_EMAIL — founder account that bypasses the beta cap. Optional;
# defaults to amitlevin65@protonmail.com. [convex dashboard]
BETA_FOUNDER_EMAIL=amitlevin65@protonmail.com
# BETA_ALLOWLIST_EMAILS — comma-separated additional beta emails (founder is
# always included). Optional. [convex dashboard]
BETA_ALLOWLIST_EMAILS=
# BETA_MAX_TESTERS — max tester accounts, founder excluded. Optional; default 30.
# [convex dashboard]
BETA_MAX_TESTERS=30

# ----------------------------------------------------------------------------
# RevenueCat (webhook — convex/revenuecat.ts)
# ----------------------------------------------------------------------------
# REVENUECAT_WEBHOOK_SECRET — must equal the "Authorization header value"
# configured in RevenueCat → Project → Webhooks. This is a shared secret YOU
# invent there — it is NOT the RevenueCat public SDK key and NOT the REST
# secret key. Required before enabling the webhook: the handler now fails
# closed (401) when unset. Client SDK keys live in apps/mobile/.env.example.
# [convex dashboard]
REVENUECAT_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Polar (server-side; read by apps/web/app/checkout/route.ts)
# ----------------------------------------------------------------------------
# Deferred — required only when payments go live. See apps/web/.env.example
# for the web-side entries.
# POLAR_ACCESS_TOKEN=
# POLAR_SUCCESS_URL=

# ----------------------------------------------------------------------------
# GetTerms (deferred — public legal doc IDs)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_GETTERMS_PRIVACY_ID=
# NEXT_PUBLIC_GETTERMS_TERMS_ID=

# ----------------------------------------------------------------------------
# Removed entries (2026-08-13 audit)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY / NEXT_PUBLIC_POSTHOG_HOST — no code reads them
# anywhere in apps/web or convex (verified by grep); deleted as dead entries.
# Re-add only together with the code that consumes them.
# TINKER_API_KEY — intentionally NOT added: Python-only SDK, trains-not-serves,
# waitlisted. Revisit when it ships a GA TypeScript client.

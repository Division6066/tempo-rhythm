#!/usr/bin/env bash
# Fixed git commands for unattended agents.
# Every subcommand refuses extra arguments. Flags, refspecs, and commit-message
# files are chosen here, never forwarded from the model command line.
# Git is the system binary, with hooks disabled, so a PATH plant or a
# .git/hooks file written during the session cannot run.
set -euo pipefail

export PATH=/usr/bin:/bin
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
export GIT_CONFIG_NOSYSTEM=1

refuse() {
  printf 'tempo-safe-git: %s\n' "$*" >&2
  exit 2
}

g() {
  /usr/bin/git -c core.hooksPath=/dev/null "$@"
}

no_args() {
  [ "$#" -eq 1 ] || refuse "$1 takes no arguments"
}

repo_file() {
  root=$(g rev-parse --show-toplevel)
  path="$root/$1"
  [ -e "$path" ] || refuse "missing $1"
  [ ! -L "$path" ] || refuse "$1 must not be a symlink"
  real=$(realpath "$path")
  case "$real" in
    "$root"/*) ;;
    *) refuse "$1 resolves outside the repository" ;;
  esac
  printf '%s\n' "$real"
}

safe_branch_name() {
  name=$1
  case "$name" in
    '' | HEAD | master | main | integration) refuse "refusing branch '$name'" ;;
    -* | *:*) refuse "refusing branch '$name'" ;;
    *..* | *//* | *' '*) refuse "refusing branch '$name'" ;;
    *[!A-Za-z0-9._/-]*) refuse "refusing branch '$name'" ;;
  esac
  case "$name" in
    claude/*) ;;
    *) refuse "branch must start with claude/" ;;
  esac
}

cmd=${1:-}
shift || true

case "$cmd" in
  status)
    no_args status "$@"
    g status --porcelain
    ;;
  diff)
    no_args diff "$@"
    g diff
    ;;
  diff-cached)
    no_args diff-cached "$@"
    g diff --cached
    ;;
  log)
    no_args log "$@"
    g log -n 20 --oneline
    ;;
  add)
    no_args add "$@"
    # Scratch files hold the issue text and the commit message. An older
    # agent branch may not gitignore them, so a plain `git add -- .` would
    # commit them. Exclude them here, not only in .gitignore.
    g add -- . \
      ':!.tempo-commit-msg' \
      ':!.tempo-branch-name' \
      ':!.tempo-issue.md' \
      ':!.tempo-request.md'
    ;;
  commit)
    no_args commit "$@"
    msg=$(repo_file .tempo-commit-msg)
    g commit --no-verify -F "$msg"
    ;;
  branch-new)
    no_args branch-new "$@"
    file=$(repo_file .tempo-branch-name)
    lines=$(grep -c '' "$file" || true)
    [ "$lines" -eq 1 ] || refuse "branch file must be one line"
    name=$(head -n 1 "$file" | tr -d '\r')
    safe_branch_name "$name"
    g checkout -b "$name"
    ;;
  push)
    no_args push "$@"
    branch=$(g rev-parse --abbrev-ref HEAD)
    safe_branch_name "$branch"
    g push --no-verify -u origin "$branch"
    ;;
  *)
    refuse "unknown command"
    ;;
esac

# ============================================================================
# apps/web — Web app environment variables
# ============================================================================
# See docs/ENVIRONMENTS.md for the four-mode contract.
# Only vars consumed directly by the Next.js app at build/runtime live here.
# Shared backend/tooling vars live in the repo-root .env.example.
# HARD_RULES §13: never commit real values. Production values live in Vercel
# project env vars. Local dev values live in a `.env.local` (git-ignored).
#
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME. apps/web/lib/env.ts fails
# `next build` when a REQUIRED one is missing, empty, or still the
# `__DUMMY_PASTE_ME__` scaffolding placeholder.
# ============================================================================

# ----------------------------------------------------------------------------
# Convex (REQUIRED at build and runtime)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_CONVEX_URL — public URL of the Convex deployment
# (https://<name>.convex.cloud). Source: Convex dashboard → deployment URL.
# Required — the build fails without it. [local .env.local] + [vercel]
NEXT_PUBLIC_CONVEX_URL=

# ----------------------------------------------------------------------------
# Feature flags (optional)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_PASSKEYS — "true" exposes the passkey (WebAuthn) settings
# page and sign-in button; unset/empty hides passkeys. Optional. [vercel]
NEXT_PUBLIC_ENABLE_PASSKEYS=

# ----------------------------------------------------------------------------
# Legal URLs (optional; defaults to /terms and /privacy routes)
# ----------------------------------------------------------------------------
# Read by apps/web/config/appConfig.ts. Source: your hosted legal pages
# (e.g. GetTerms). [vercel]
# NEXT_PUBLIC_TERMS_URL=
# NEXT_PUBLIC_PRIVACY_URL=

# ----------------------------------------------------------------------------
# Polar payments (deferred — required only when payments go live)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_POLAR_MONTHLY_PRODUCT_ID / NEXT_PUBLIC_POLAR_YEARLY_PRODUCT_ID —
# product ids shown on the pricing surface (apps/web/config/polarConfig.ts).
# Source: polar.sh dashboard → Products. Optional until payments ship. [vercel]
# NEXT_PUBLIC_POLAR_MONTHLY_PRODUCT_ID=
# NEXT_PUBLIC_POLAR_YEARLY_PRODUCT_ID=

# POLAR_ACCESS_TOKEN — server-only organization token used by /checkout
# (never exposed client-side; requested per-request, named-variable error
# when missing). Source: polar.sh dashboard → Settings → Access Tokens. [vercel, server-side]
# POLAR_ACCESS_TOKEN=

# POLAR_SUCCESS_URL — redirect after checkout; include `{CHECKOUT_ID}`.
# Source: your own site URL. [vercel, server-side]
# POLAR_SUCCESS_URL=

# ----------------------------------------------------------------------------
# Test-only toggles (never configure in Vercel Production/Preview)
# ----------------------------------------------------------------------------
# TEMPO_E2E_PUBLIC_CALENDAR — "1" during calendar e2e runs against local dev.
TEMPO_E2E_PUBLIC_CALENDAR=
# TEMPO_E2E_AUTH_BYPASS / NEXT_PUBLIC_TEMPO_E2E_AUTH_BYPASS — "1" during e2e
# runs to bypass auth locally (ignored when NODE_ENV=production).
# TEMPO_E2E_AUTH_BYPASS=
# NEXT_PUBLIC_TEMPO_E2E_AUTH_BYPASS=

# ----------------------------------------------------------------------------
# Removed entries (2026-08-13 audit)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY / NEXT_PUBLIC_POSTHOG_HOST — no code reads them
# (verified by grep across apps/web and convex); deleted as dead entries.

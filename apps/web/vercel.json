{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "devCommand": "next dev",
  "ignoreCommand": "[ \"$VERCEL_GIT_PREVIOUS_SHA\" != \"$VERCEL_GIT_COMMIT_SHA\" ] && git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../../convex ../../packages ../../package.json ../../bun.lock",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  }
}
